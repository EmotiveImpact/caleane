{
  "name": "pagedly",
  "version": "1.1.0",
  "description": "Word-style paged rich-text editor for React. Word-level reflow at page boundaries, in-document find/replace, native browser print with letterhead injection. Cross-browser (Chromium + WebKit).",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "author": "",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/pagedly.umd.cjs",
  "module": "./dist/pagedly.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/pagedly.js",
      "require": "./dist/pagedly.umd.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "dev": "vite --config demo/vite.config.ts --host 127.0.0.1 --port 5174",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:headed": "HEADED=1 playwright test"
  },
  "peerDependencies": {
    "react": ">=18.2.0 || >=19.0.0",
    "react-dom": ">=18.2.0 || >=19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "dompurify": "^3.4.2",
    "lucide-react": "^0.475.0",
    "pagedjs": "^0.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
